{
  "extends": ["html-validate:recommended"],
  "rules": {
    "void-style": "off",
    "no-inline-style": "off",
    "require-sri": "off",
    "long-title": "off",
    "attribute-boolean-style": "off",
    "no-trailing-whitespace": "off",
    "element-required-attributes": "error",
    "wcag/h30": "error",
    "wcag/h32": "off",
    "wcag/h37": "error",
    "wcag/h63": "error",
    "wcag/h67": "off"
  }
}
